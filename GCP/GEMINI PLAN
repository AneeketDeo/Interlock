def batch_breakdown_fallback(impact):
    for k, v in impact["batch_status_breakdown"].items():
        if k not in ("IN_PROGRESS", "SHIPPED"):
            return v.get("batches", 56)
    return 56


def write_proposals_to_spanner(db, incident_id: str, brief: RcaExecutiveBrief):
    """Writes Cause, Decision, and Action (status='PROPOSED') nodes + graph edges back into Spanner."""
    now = datetime.now(timezone.utc)
    decision_id = "DEC-2026-1015-001"
    cause_id = "CAU-2026-1015-001"

    with db.batch() as b:
        # 1. Write Cause node & HasCause + CauseMapsTo edges
        b.insert_or_update(
            table="Cause",
            columns=["cause_id", "incident_id", "description", "category", "confidence"],
            values=[[cause_id, incident_id, brief.d4_root_cause_statement, "Material x Method Compound", 0.98]]
        )
        b.insert_or_update(
            table="HasCause",
            columns=["incident_id", "cause_id"],
            values=[[incident_id, cause_id]]
        )
        b.insert_or_update(
            table="CauseMapsTo",
            columns=["cause_id", "failure_mode_id"],
            values=[[cause_id, "FM-01"], [cause_id, "FM-02"]]
        )

        # 2. Write Decision node & HasDecision edge (status = PROPOSED for HITL gate)
        b.insert_or_update(
            table="Decision",
            columns=["decision_id", "incident_id", "decision_type", "proposed_by", "summary", "status"],
            values=[[decision_id, incident_id, "8D_CONTAINMENT_AND_CAPA", "ADK-Gemini-Agent", brief.d2_problem_summary, "PROPOSED"]]
        )
        b.insert_or_update(
            table="HasDecision",
            columns=["incident_id", "decision_id"],
            values=[[incident_id, decision_id]]
        )

        # 3. Write Action nodes (status = PROPOSED — agent NEVER executes without human approval)
        action_rows = []
        for idx, act in enumerate(brief.proposed_actions, start=1):
            act_id = f"ACT-2026-1015-00{idx}"
            payload = json.dumps({"reversible": act.reversible, "incident_id": incident_id})
            action_rows.append([
                act_id, incident_id, decision_id, act.action_type,
                act.target_id, act.description, "PROPOSED", "ADK-Gemini-Agent", now, payload
            ])
        b.insert_or_update(
            table="Action",
            columns=["action_id", "incident_id", "decision_id", "action_type",
                     "target_id", "description", "status", "proposed_by", "proposed_at", "payload"],
            values=action_rows
        )
    return decision_id, cause_id


def publish_incident_event(incident_id: str, decision_id: str, brief: RcaExecutiveBrief):
    """Publishes the RCA diagnosis event to Google Cloud Pub/Sub."""
    try:
        publisher = pubsub_v1.PublisherClient()
        topic_path = publisher.topic_path(PROJECT, "rca-incident-trigger")
        msg = json.dumps({
            "incident_id": incident_id,
            "decision_id": decision_id,
            "status": "AWAITING_HUMAN_APPROVAL",
            "root_cause": brief.d4_root_cause_statement,
            "actions_count": len(brief.proposed_actions)
        }).encode("utf-8")
        future = publisher.publish(topic_path, msg)
        print(f"  [PUB/SUB] Published RCA Decision '{decision_id}' to topic 'rca-incident-trigger' (msg_id={future.result(timeout=5)}).")
    except Exception as e:
        print(f"  [PUB/SUB INFO] Skipped live publish ({e}).")


