@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rca:   <http://rca-sentinel.io/ontology#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# SHACL Shapes for RCA-Sentinel Graph Validation
# Validated by pyshacl in Python BEFORE graph writes.
# =============================================================================

# ── Plant ───────────────────────────────────────────────────────────

rca:PlantShape a sh:NodeShape ;
    sh:targetClass rca:Plant ;
    sh:property [
        sh:path rca:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Plant must have exactly one name."
    ] ;
    sh:property [
        sh:path rca:code ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Plant must have exactly one code."
    ] .

# ── Line ────────────────────────────────────────────────────────────

rca:LineShape a sh:NodeShape ;
    sh:targetClass rca:Line ;
    sh:property [
        sh:path rca:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Line must have a name."
    ] ;
    sh:property [
        sh:path rca:code ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Line must have a code."
    ] ;
    sh:property [
        sh:path rca:downtime_cost_per_hour ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
        sh:message "Downtime cost must be non-negative."
    ] .

# ── Machine ─────────────────────────────────────────────────────────

rca:MachineShape a sh:NodeShape ;
    sh:targetClass rca:Machine ;
    sh:property [
        sh:path rca:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Machine must have a name."
    ] ;
    sh:property [
        sh:path rca:code ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Machine must have a code."
    ] .

# ── Sensor ──────────────────────────────────────────────────────────

rca:SensorShape a sh:NodeShape ;
    sh:targetClass rca:Sensor ;
    sh:property [
        sh:path rca:tag ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Sensor must have a tag."
    ] ;
    sh:property [
        sh:path rca:sensor_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "temperature" "vibration" "pressure" "current" "speed" "torque" "flow_rate" "humidity" ) ;
        sh:message "Sensor type must be one of the defined types."
    ] .

# ── MaterialLot ─────────────────────────────────────────────────────

rca:MaterialLotShape a sh:NodeShape ;
    sh:targetClass rca:MaterialLot ;
    sh:property [
        sh:path rca:lot_number ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "MaterialLot must have exactly one lot_number."
    ] ;
    sh:property [
        sh:path rca:material_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "MaterialLot must have a material_type."
    ] ;
    sh:property [
        sh:path rca:quantity ;
        sh:datatype xsd:float ;
        sh:minExclusive 0 ;
        sh:message "MaterialLot quantity must be positive."
    ] .

# ── Supplier ────────────────────────────────────────────────────────

rca:SupplierShape a sh:NodeShape ;
    sh:targetClass rca:Supplier ;
    sh:property [
        sh:path rca:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Supplier must have a name."
    ] ;
    sh:property [
        sh:path rca:tier ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 3 ;
        sh:message "Supplier tier must be 1, 2, or 3."
    ] .

# ── MaintenanceLog ──────────────────────────────────────────────────

rca:MaintenanceLogShape a sh:NodeShape ;
    sh:targetClass rca:MaintenanceLog ;
    sh:property [
        sh:path rca:maintenance_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "preventive" "corrective" "calibration" "inspection" ) ;
        sh:message "MaintenanceLog must have a valid maintenance_type."
    ] ;
    sh:property [
        sh:path rca:performed_at ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "MaintenanceLog must have a performed_at timestamp."
    ] .

# ── Incident ────────────────────────────────────────────────────────

rca:IncidentShape a sh:NodeShape ;
    sh:targetClass rca:Incident ;
    sh:property [
        sh:path rca:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Incident must have a title."
    ] ;
    sh:property [
        sh:path rca:severity ;
        sh:datatype xsd:string ;
        sh:in ( "low" "medium" "high" "critical" ) ;
        sh:message "Incident severity must be one of: low, medium, high, critical."
    ] ;
    sh:property [
        sh:path rca:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Incident must have a status."
    ] .

# ── DecisionObject ──────────────────────────────────────────────────

rca:DecisionObjectShape a sh:NodeShape ;
    sh:targetClass rca:DecisionObject ;
    sh:property [
        sh:path rca:stage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "detect" "diagnose" "classify" "forecast" "remediate" ) ;
        sh:message "DecisionObject stage must be one of the RCA stages."
    ] ;
    sh:property [
        sh:path rca:confidence ;
        sh:datatype xsd:float ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "DecisionObject confidence must be between 0 and 1."
    ] ;
    sh:property [
        sh:path rca:incident_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "DecisionObject must reference an incident."
    ] .

# ── Approval ────────────────────────────────────────────────────────

rca:ApprovalShape a sh:NodeShape ;
    sh:targetClass rca:Approval ;
    sh:property [
        sh:path rca:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "pending" "approved" "rejected" "expired" ) ;
        sh:message "Approval status must be one of: pending, approved, rejected, expired."
    ] ;
    sh:property [
        sh:path rca:action_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Approval must reference an action."
    ] .

# ── FailureMode ─────────────────────────────────────────────────────

rca:FailureModeShape a sh:NodeShape ;
    sh:targetClass rca:FailureMode ;
    sh:property [
        sh:path rca:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "FailureMode must have a name."
    ] ;
    sh:property [
        sh:path rca:severity_score ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 10 ;
        sh:message "FailureMode severity_score must be 1-10."
    ] ;
    sh:property [
        sh:path rca:occurrence_score ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 10 ;
        sh:message "FailureMode occurrence_score must be 1-10."
    ] ;
    sh:property [
        sh:path rca:detection_score ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 10 ;
        sh:message "FailureMode detection_score must be 1-10."
    ] .

# ── WorkOrder ───────────────────────────────────────────────────────

rca:WorkOrderShape a sh:NodeShape ;
    sh:targetClass rca:WorkOrder ;
    sh:property [
        sh:path rca:order_number ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "WorkOrder must have an order number."
    ] ;
    sh:property [
        sh:path rca:quantity_planned ;
        sh:datatype xsd:integer ;
        sh:minExclusive 0 ;
        sh:message "WorkOrder quantity_planned must be positive."
    ] .
