# =============================================================================
# RCA-Sentinel Environment Configuration Example (Google Cloud Platform 2026)
# Copy to .env and fill in values
# =============================================================================

# --- Application ---
APP_ENV=dev                          # dev | demo | prod
APP_NAME=rca-sentinel
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173   # comma-separated
SECRET_KEY=change-me-to-a-random-secret-key

# --- Google Cloud Platform (Core Stack) ---
GCP_PROJECT_ID=project-a8fa4909-225e-4882-b45
GCP_LOCATION=us-central1
SPANNER_INSTANCE_ID=rca
SPANNER_DATABASE_ID=rca-db
SPANNER_GRAPH_NAME=FactoryGraph
PUBSUB_TOPIC_ID=telemetry-ingest-topic
PUBSUB_SUBSCRIPTION_ID=telemetry-anomaly-sub
BIGQUERY_DATASET=rca_historian
BIGQUERY_TABLE=ObservationWindow
USE_VERTEX_AI=true
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Google ADK / Vertex AI / Gemini ---
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
AGENT_CONFIDENCE_THRESHOLD=0.7

# --- FastMCP Server ---
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_AUTH_TOKEN=change-me-mcp-token

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Actuators ---
DRY_RUN=true
KILL_SWITCH_ENABLED=false
ACTUATOR_RATE_LIMIT=5                # max actions per minute

# --- Synthetic Data / Golden Scenario ---
SIMULATOR_SCALE=1.0
SIMULATOR_SEED=42
GOLDEN_SCENARIO_DATE=2024-09-15

# --- Feature Flags ---
PROACTIVE_DETECTION_ENABLED=false

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- Legacy Fallback Services (Optional) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=neo4j
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=rca
TIMESCALE_PASSWORD=rca_password
TIMESCALE_DB=rca_sentinel
REDIS_URL=redis://redis:6379/0
